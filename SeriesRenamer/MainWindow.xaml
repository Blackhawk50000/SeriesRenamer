<Window x:Class="SeriesRenamer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serien-Umbenenner" Height="750" Width="1250" MinHeight="450" MinWidth="800"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Feste Zeilenhöhe, damit linke und rechte Liste exakt nebeneinander laufen -->
        <Style x:Key="RowItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="Gray" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Ready">
                    <Setter Property="Foreground" Value="#1E7B34" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Renamed">
                    <Setter Property="Foreground" Value="#1565C0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter Property="Foreground" Value="#C62828" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="8">

        <!-- Einstellungen -->
        <GroupBox DockPanel.Dock="Top" Header="Einstellungen" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="TMDb API-Key:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <PasswordBox x:Name="ApiKeyBox" Grid.Column="1" Padding="2"
                             ToolTip="v3 API-Key oder v4 Read Access Token von themoviedb.org/settings/api" />

                <TextBlock Grid.Column="2" Text="Sprache:" VerticalAlignment="Center" Margin="16,0,8,0" />
                <ComboBox x:Name="LanguageBox" Grid.Column="3" IsEditable="True"
                          ToolTip="Sprache der Serien- und Episodentitel (z. B. de-DE, en-US)">
                    <ComboBoxItem Content="de-DE" />
                    <ComboBoxItem Content="en-US" />
                    <ComboBoxItem Content="fr-FR" />
                    <ComboBoxItem Content="es-ES" />
                    <ComboBoxItem Content="ja-JP" />
                </ComboBox>

                <TextBlock Grid.Row="1" Text="Muster:" VerticalAlignment="Center" Margin="0,8,8,0" />
                <TextBox x:Name="PatternBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                         Margin="0,8,0,0" Padding="2" FontFamily="Consolas" FontSize="13"
                         TextChanged="PatternBox_TextChanged" />

                <TextBlock x:Name="PatternHelp" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                           Margin="0,4,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <!-- Serie manuell festlegen -->
        <GroupBox DockPanel.Dock="Top" Header="Serie manuell festlegen (falls die automatische Erkennung danebenliegt)"
                  Padding="6" Margin="0,6,0,0">
            <DockPanel>
                <Button x:Name="AssignSeriesButton" DockPanel.Dock="Right" Content="Für Auswahl übernehmen"
                        Padding="10,2" Margin="8,0,0,0" Click="AssignSeries_Click"
                        ToolTip="Setzt die gewählte Serie für die markierten Dateien (oder alle, wenn nichts markiert ist)" />
                <ComboBox x:Name="SeriesResults" DockPanel.Dock="Right" Width="320" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Suchen" Padding="10,2" Margin="8,0,0,0" Click="SeriesSearch_Click" />
                <TextBox x:Name="SeriesQueryBox" Padding="2" KeyDown="SeriesQueryBox_KeyDown" />
            </DockPanel>
        </GroupBox>

        <!-- Aktionen -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" LastChildFill="True">
            <Button x:Name="RenameButton" DockPanel.Dock="Right" Content="Dateien umbenennen"
                    Padding="16,6" FontWeight="SemiBold" Click="Rename_Click" />
            <Button x:Name="UndoButton" DockPanel.Dock="Right" Content="Rückgängig" Padding="12,6"
                    Margin="0,0,8,0" Click="Undo_Click" IsEnabled="False" />
            <Button x:Name="MatchButton" DockPanel.Dock="Left" Content="Mit TMDb abgleichen" Padding="12,6"
                    Click="Match_Click" />
            <Button DockPanel.Dock="Left" Content="Markierte entfernen" Padding="12,6" Margin="8,0,0,0"
                    Click="RemoveSelected_Click" />
            <Button DockPanel.Dock="Left" Content="Liste leeren" Padding="12,6" Margin="8,0,0,0"
                    Click="Clear_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Zweigeteilter Bereich -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Originaldateien" FontWeight="SemiBold" Margin="2,0,0,4" />
            <TextBlock Grid.Column="2" Text="Neue Namen" FontWeight="SemiBold" Margin="2,0,0,4" />

            <ListBox x:Name="LeftList" Grid.Row="1" SelectionMode="Extended" AllowDrop="True"
                     ItemContainerStyle="{StaticResource RowItemStyle}"
                     DragOver="LeftList_DragOver" Drop="LeftList_Drop"
                     SelectionChanged="List_SelectionChanged" KeyDown="List_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel ToolTip="{Binding FullPath}">
                            <TextBlock Text="{Binding OriginalName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DetectionInfo}" FontSize="11" Foreground="Gray"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="DropHint" Grid.Row="1" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="Gray" FontSize="14"
                       Text="Videodateien oder Ordner hierher ziehen&#x0a;(z. B. Serienname.S01E05.1080p.mkv)" />

            <GridSplitter Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Background="#EEE" />

            <ListBox x:Name="RightList" Grid.Row="1" Grid.Column="2" SelectionMode="Extended"
                     ItemContainerStyle="{StaticResource RowItemStyle}"
                     SelectionChanged="List_SelectionChanged" KeyDown="List_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding NewName}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding NewName}" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
